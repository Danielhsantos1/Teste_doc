# Copie para .env e ajuste os valores. Nunca commitar .env com segredos reais.

DATABASE_URL="postgresql://docdeck:docdeck_dev_pw@localhost:5432/docdeck?schema=public"
# Usada só por `prisma migrate`/`db push`. Em dev local, mesma URL acima. Em
# produção (Neon), aponta para a conexão DIRETA (sem "-pooler"), enquanto
# DATABASE_URL usa a conexão via pooler — ver DEPLOY.md.
DIRECT_URL="postgresql://docdeck:docdeck_dev_pw@localhost:5432/docdeck?schema=public"

# API
API_PORT=4000
JWT_SECRET="dev-only-change-me"
JWT_EXPIRES_IN="8h"

# Document Intelligence (packages/ai) — sem AI_API_KEY, POST /documents/:id/analyze
# responde 503 de forma honesta em vez de simular uma análise.
AI_PROVIDER="anthropic"
AI_MODEL="claude-sonnet-5"
AI_API_KEY=

# Web
NEXT_PUBLIC_API_URL="http://localhost:4000"
